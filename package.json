{
  "name": "rwanda-response-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/local-next.mjs dev",
    "build": "node scripts/local-next.mjs build",
    "start": "node scripts/local-next.mjs start",
    "typecheck": "tsc --noEmit --incremental false",
    "db:setup": "node --env-file=.env.local scripts/setup.mjs",
    "test:api": "node --test scripts/api-smoke.mjs",
    "db:init": "node scripts/init-db.mjs",
    "db:check": "node --env-file=.env.local scripts/users.mjs check",
    "users:create": "node --env-file=.env.local scripts/users.mjs create",
    "users:list": "node --env-file=.env.local scripts/users.mjs list",
    "users:reset": "node --env-file=.env.local scripts/users.mjs reset",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "test:workflow": "node --env-file=.env.local --test scripts/verification.test.mjs",
    "db:backup": "node --env-file=.env.local scripts/backup.mjs",
    "test:safety": "node --test scripts/local-only.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.15",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
